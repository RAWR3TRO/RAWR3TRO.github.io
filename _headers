# Cache policy for Cloudflare Pages / Netlify.
#
# "immutable" is only safe where a changed file gets a changed URL.
#
#   css/ and js/  ARE safe: index.html references them with a ?v= content hash
#                 (see _build/stamp.py), so editing one changes the URL and the
#                 old entry is simply never requested again.
#   models/fonts  ARE safe: they do not change without being renamed.
#   everything else in assets/ is NOT: swapping a channel or a prop reuses the
#                 same filename, so caching it forever would pin the old one.

# content-hashed by ?v= — a change is a new URL
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/models/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/audio/*
  Cache-Control: public, max-age=604800

# reels, posters and cut-outs get replaced in place — revalidate daily
/assets/*
  Cache-Control: public, max-age=86400

# the entry point must never be stale, or a deploy does not take effect
/index.html
  Cache-Control: public, max-age=0, must-revalidate
