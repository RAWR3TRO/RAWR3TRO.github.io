# Cache policy for Cloudflare Pages / Netlify.
#
# Nothing here is content-hashed, so "immutable" is only safe on files that
# genuinely never change. The model and the fonts qualify; the clips and posters
# do not, because swapping a channel reuses the same filename.

/assets/models/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/audio/*
  Cache-Control: public, max-age=604800

# reels, posters and cut-outs get replaced in place — revalidate daily
/assets/*
  Cache-Control: public, max-age=86400

# the entry point must never be stale, or a deploy does not take effect
/index.html
  Cache-Control: public, max-age=0, must-revalidate
